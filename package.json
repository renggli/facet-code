{
  "name": "facet-code",
  "displayName": "Facet Code",
  "description": "Structural, configurable code browser.",
  "icon": "media/facet-logo.png",
  "version": "0.1.0",
  "author": "Lukas Renggli (https://www.lukas-renggli.ch/)",
  "publisher": "LukasRenggli",
  "license": "MIT",
  "homepage": "https://github.com/renggli/facet-code",
  "repository": {
    "type": "git",
    "url": "https://github.com/renggli/facet-code.git"
  },
  "bugs": {
    "url": "https://github.com/renggli/facet-code/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/renggli"
  },
  "funding": "https://github.com/sponsors/renggli",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "navigation",
    "symbol",
    "outline",
    "structure",
    "hierarchy",
    "references",
    "call-hierarchy",
    "type-hierarchy"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "facet-container",
          "title": "Facet",
          "icon": "media/facet-logo.png"
        }
      ]
    },
    "views": {
      "facet-container": [
        {
          "id": "facet.pane.1",
          "name": "Directories",
          "when": "facet.pane.1.visible"
        },
        {
          "id": "facet.pane.2",
          "name": "Files",
          "when": "facet.pane.2.visible"
        },
        {
          "id": "facet.pane.3",
          "name": "Definitions",
          "when": "facet.pane.3.visible"
        },
        {
          "id": "facet.pane.4",
          "name": "Members",
          "when": "facet.pane.4.visible"
        },
        {
          "id": "facet.pane.5",
          "name": "References",
          "when": "facet.pane.5.visible"
        },
        {
          "id": "facet.pane.6",
          "name": "Implementations",
          "when": "facet.pane.6.visible"
        }
      ]
    },
    "commands": [
      {
        "command": "facet.focus",
        "title": "Facet: Focus",
        "category": "Facet",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "facet.syncCursorAndFocus",
        "title": "Facet: Select at Cursor and Focus",
        "category": "Facet",
        "icon": "$(target)"
      },
      {
        "command": "facet.addPane",
        "title": "Facet: Add Pane",
        "icon": "$(add)"
      },
      {
        "command": "facet.removePane",
        "title": "Facet: Remove Pane...",
        "icon": "$(trash)"
      },
      {
        "command": "facet.applyPreset",
        "title": "Facet: Apply Preset...",
        "icon": "$(layers)"
      },
      {
        "command": "facet.savePreset",
        "title": "Facet: Save Preset...",
        "icon": "$(save)"
      },
      {
        "command": "facet.loadPreset",
        "title": "Facet: Load Preset...",
        "icon": "$(folder-opened)"
      },
      {
        "command": "facet.deletePreset",
        "title": "Facet: Delete Preset...",
        "icon": "$(trash)"
      },
      {
        "command": "facet.pane.1.toggleTree.on",
