        {
          "command": "facet.pane.1.toggleTree.on",
          "when": "view == facet.pane.1 && facet.pane.1.hasTree && facet.pane.1.isTree",
          "group": "navigation@1"
        },
        {
          "command": "facet.pane.1.toggleTree.off",
          "when": "view == facet.pane.1 && facet.pane.1.hasTree && !facet.pane.1.isTree",
          "group": "navigation@1"
        },
        {
          "command": "facet.pane.1.filter",
          "when": "view == facet.pane.1 && facet.pane.1.hasFilter",
          "group": "navigation@3"
