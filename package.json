      {
        "command": "facet.focus",
        "key": "ctrl+k f",
        "mac": "cmd+k f"
      },
      {
        "command": "facet.syncCursorAndFocus",
        "key": "ctrl+k shift+f",
        "mac": "cmd+k shift+f",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Facet",
      "properties": {
        "facet.autoSyncCursor": {
          "type": "boolean",
          "default": true,
          "description": "Automatically synchronize Facet pane selections with the active editor cursor position."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "check": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "test:unit": "mocha -r ./out/test/unit/mockVscode.js --ui tdd --exit out/test/unit/**/*.test.js",
    "test": "npm run test:unit"
  },
