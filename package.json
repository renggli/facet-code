{
	"name": "facet-code",
	"displayName": "Facet Code",
	"description": "Structural, configurable code browser.",
	"version": "0.1.0",
	"engines": {
		"vscode": "^1.138.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"icon": "media/facet-logo.png",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "facet-container",
					"title": "Facet",
					"icon": "media/facet-logo.png"
				}
			]
		},
		"views": {
			"facet-container": [
				{
					"id": "facet.pane.1",
					"name": "Types",
					"icon": "$(symbol-class)",
					"when": "facet.pane.1.visible"
				},
				{
					"id": "facet.pane.2",
					"name": "Members",
					"icon": "$(symbol-method)",
					"when": "facet.pane.2.visible"
				},
				{
					"id": "facet.pane.3",
					"name": "References",
					"icon": "$(references)",
					"when": "facet.pane.3.visible"
				},
				{
					"id": "facet.pane.4",
					"name": "Implementations",
					"icon": "$(type-hierarchy-sub)",
					"when": "facet.pane.4.visible"
				},
				{
					"id": "facet.pane.5",
					"name": "Callers",
					"icon": "$(call-incoming)",
					"when": "facet.pane.5.visible"
				},
				{
					"id": "facet.pane.6",
					"name": "Hierarchy",
					"icon": "$(type-hierarchy)",
					"when": "facet.pane.6.visible"
				}
			]
		},
		"configuration": {
			"title": "Facet",
			"properties": {
				"facet.types.scope": {
					"type": "string",
					"enum": [
						"file",
						"project"
					],
					"default": "file",
					"description": "Scope for the Types view: current active file or all types across the project."
				}
			}
		},
		"commands": [
			{
				"command": "facet.pane.1.configure",
				"title": "Facet: Configure Pane 1",
				"icon": "$(gear)"
			},
			{
				"command": "facet.pane.2.configure",
				"title": "Facet: Configure Pane 2",
				"icon": "$(gear)"
			},
			{
				"command": "facet.pane.3.configure",
				"title": "Facet: Configure Pane 3",
				"icon": "$(gear)"
			},
			{
				"command": "facet.pane.4.configure",
				"title": "Facet: Configure Pane 4",
				"icon": "$(gear)"
			},
			{
				"command": "facet.pane.5.configure",
				"title": "Facet: Configure Pane 5",
				"icon": "$(gear)"
			},
			{
				"command": "facet.pane.6.configure",
				"title": "Facet: Configure Pane 6",
				"icon": "$(gear)"
			},
			{
				"command": "facet.pane.configure",
				"title": "Facet: Configure Pane...",
				"icon": "$(gear)"
			},
			{
				"command": "facet.pane.presets",
				"title": "Facet: View Presets",
				"icon": "$(layers)"
			},
			{
				"command": "facet.toggleScope",
				"title": "Facet: Toggle Scope (File / Project)",
				"icon": "$(globe)"
			},
			{
				"command": "facet.revealRange",
				"title": "Facet: Reveal in Editor"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "facet.pane.1.configure",
					"when": "view == facet.pane.1",
					"group": "navigation@1"
				},
				{
					"command": "facet.pane.2.configure",
					"when": "view == facet.pane.2",
					"group": "navigation@1"
				},
				{
					"command": "facet.pane.3.configure",
					"when": "view == facet.pane.3",
					"group": "navigation@1"
				},
				{
					"command": "facet.pane.4.configure",
					"when": "view == facet.pane.4",
					"group": "navigation@1"
				},
				{
					"command": "facet.pane.5.configure",
					"when": "view == facet.pane.5",
					"group": "navigation@1"
				},
				{
					"command": "facet.pane.6.configure",
					"when": "view == facet.pane.6",
					"group": "navigation@1"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test:unit": "mocha --ui tdd out/test/unit/**/*.test.js",
		"test": "npm run test:unit"
	},
	"devDependencies": {
		"@types/vscode": "^1.138.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"typescript-eslint": "^8.61.1",
		"eslint": "^10.5.0",
		"typescript": "^6.0.3",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	}
}
